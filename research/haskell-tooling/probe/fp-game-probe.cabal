cabal-version: 3.0
name: fp-game-probe
version: 0.1.0.0
build-type: Simple
executable fp-game-probe
  main-is: Main.hs
  hs-source-dirs: app
  default-language: GHC2021
  ghc-options: -Wall -Werror -threaded
  build-depends: base >=4.18 && <4.19, aeson ==2.2.5.0, bytestring, text, directory, filepath, process, temporary ==1.3, unix
