cabal-version: 3.0
name: red-dune-federation
version: 0.6.0.0
build-type: Simple
synopsis: In-progress pure reference colony simulation foundation
license: MIT
license-file: LICENSE

executable red-dune
  main-is: Main.hs
  hs-source-dirs: app, src, test
  default-language: GHC2021
  ghc-options: -O2 -Wall -Werror -rtsopts -threaded
  build-depends: base >=4.18 && <4.19, containers, array, bytestring, text, parsec, binary, deepseq, mtl, directory, unix, filepath, game-arena >=0.1 && <0.2, game-transition >=0.1 && <0.2
  other-modules:
    CodecTests
