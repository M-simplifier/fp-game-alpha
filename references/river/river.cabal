cabal-version: 3.0
name: river-home-reference
version: 0.1.0.0
synopsis: Pure village simulation with validated saves and fixed-tick host clock
description: River Home rules and protocol adapter over shared Step/Arena APIs.
license: MIT
license-file: LICENSE
build-type: Simple

common checked
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror

library
  import: checked
  hs-source-dirs: src
  exposed-modules: Life.Domain, Life.Clock, Life.Adapter
  other-modules: Life.Internal.Core, Life.Internal.Snapshot,
                 Life.Internal.Presentation, Life.Internal.Journey
  build-depends: base >=4.22 && <4.23, text, containers,
                 game-transition ==0.1.0.0, game-arena ==0.1.0.0

test-suite river-laws
  import: checked
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Laws.hs
  other-modules: River.Gameplay, River.Snapshot, River.Protocol
  build-depends: base, text, river-home-reference,
                 game-transition, game-arena
