cabal-version: 3.0
name: game-arena
version: 0.1.0.0
synopsis: Admission, observation and bounded finite game analysis
description: Game-specific admission compiles joint actions and external
             context to original inputs. Optional finite turn-based analysis.
license: MIT
license-file: LICENSE
author: Project contributors
maintainer: M-simplifier
category: Game
build-type: Simple

common checked
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror

library
  import: checked
  hs-source-dirs: src
  exposed-modules: Game.Arena, Game.Arena.Finite
  build-depends: base >=4.18 && <5, game-transition >=0.1 && <0.2

test-suite arena-laws
  import: checked
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Laws.hs
  build-depends: base, game-transition, game-arena
