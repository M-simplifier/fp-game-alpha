cabal-version: 3.0
name: lantern-puzzle
version: 0.1.0.0
synopsis: Finite puzzle over the shared Step and Arena APIs
description: Complete-information puzzle with board validation and finite analysis.
license: MIT
license-file: LICENSE
build-type: Simple

common checked
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror

library
  import: checked
  hs-source-dirs: src
  exposed-modules: Lantern
  build-depends: base >=4.18 && <5, game-transition ==0.1.0.0, game-arena ==0.1.0.0

test-suite lantern-laws
  import: checked
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Laws.hs
  build-depends: base, lantern-puzzle, game-transition, game-arena
