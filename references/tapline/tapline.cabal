cabal-version: 3.0
name: tapline
version: 0.1.0.0
synopsis: Ordered-key six-round pure game reference
description: Pure frame scheduler, render projection, and shared Step/Arena adapters.
license: MIT
license-file: LICENSE
build-type: Simple

common checked
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror

library
  import: checked
  hs-source-dirs: src
  exposed-modules: Tapline.Clock, Tapline.Input, Tapline.Domain, Tapline.View, Tapline.Adapter
  build-depends: base >=4.18 && <5, game-transition ==0.1.0.0, game-arena ==0.1.0.0

test-suite tapline-laws
  import: checked
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Laws.hs
  build-depends: base, tapline, game-transition, game-arena
