cabal-version: 3.0
name: {{SLUG}}
version: 0.1.0.0
synopsis: {{TITLE}}
description: An editable game project with a pure kernel and explicit IO host.
license: {{CABAL_LICENSE}}
build-type: Simple
extra-source-files: README.md, GAME-SPEC.md, config/game.conf, docs/*.md, assets/*.md, licenses/*.txt

common checked
  default-language: GHC2021
  ghc-options: -Wall -Wcompat -Werror

library
  import: checked
  hs-source-dirs: src
  exposed-modules: Game.Model, Game.Rules, Game.View, Game.Adapter, Game.Save
  other-modules: Game.Model.Internal
  build-depends: base >=4.18 && <5, game-transition ==0.1.0.0, game-arena ==0.1.0.0

executable {{SLUG}}
  import: checked
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base, {{SLUG}}, game-arena, directory, filepath

test-suite game-tests
  import: checked
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base, {{SLUG}}, game-arena
